# MongoDB shared with healthmatrix-app
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DB_NAME=healthmatrix

# Twilio Verify sends the OTPs (see src/lib/otp-sender.ts). Without these, codes are shown on
# screen in local dev and refused in production. Both services must use 6-digit codes.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Verify service for doctor sign-in codes
SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verify service for the OTP a patient or nominee reads out to open their record
TWILIO_RECORD_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Test mode: show OTPs on screen instead of sending them (also skips Twilio). For a deployed site
# with no SMS provider, or to test locally without spending SMS.
# Anyone with the URL can then sign in as any number. Test data only; never on the real site.
# OTP_SHOW_CODE=true

# Twilio Video for consults (console.twilio.com > Account > API keys & tokens). Same values as
# healthmatrix-app. TWILIO_ACCOUNT_SID above is shared. Without these, the consult page says
# video calls are not set up (see src/lib/video.ts).
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# Mobilab runs the tests at the pods (see src/lib/mobilab.ts). The console reads the bookings the
# app makes, files their results and opens their PDF reports. Staging until production is set up.
# Use a live key (mlab_…) on the deployed site; a test key (test_…) gives made-up results and is
# ignored in production. Needs the bookings:read and results:read scopes. Without a key, the lab
# card shows the last statuses on file.
MOBILAB_API_URL=https://api-staging.mobilab.ai
MOBILAB_API_KEY=mlab_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude (Opus 5.5, medium effort) writes Ekaay's answers in "Ask the record" (see src/lib/ekaay.ts).
# Each question sends the open patient's record (no name, phone or IDs) to Anthropic. Without the
# key, the box says Ekaay isn't connected.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
